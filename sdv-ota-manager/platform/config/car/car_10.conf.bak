# SDV Feature Flag Platform Configuration (car_10)
#
# Experiment group instance: car_10 (logs/car_10)

address 0.0.0.0:50060

# Feature Communication
communication EventBusHost

# Center Communication (Daemons)
communication DataCollector
communication SignalReceiver
communication SignalSender
communication MqttVehicleAgentHost

# Features
feature WatchDog
feature NavigationFeature
feature NavigationFeatureShadow
feature AdasFeature
feature AdasFeatureShadow
feature EvEnergyFeature
feature EvEnergyFeatureShadow
feature FeatureEvaluator








































# --- fleet deploy (managed by DeploymentMgr sync-config; do not edit) ---
fleet_schema 1

fleet_adas_slot B
fleet_adas_version v1.0
fleet_adas_mode primary
fleet_adas_enabled ON
fleet_adas_image localhost:5000/sdv/adas-feature:v1.0
fleet_adas_binary_path active/AdasFeature

fleet_navigation_slot B
fleet_navigation_version v3.0
fleet_navigation_mode primary
fleet_navigation_enabled ON
fleet_navigation_image localhost:5000/sdv/navigation-feature:v3.0
fleet_navigation_binary_path active/NavigationFeature

fleet_energy_slot B
fleet_energy_version v3.0
fleet_energy_mode primary
fleet_energy_enabled ON
fleet_energy_image localhost:5000/sdv/evenergy-feature:v3.0
fleet_energy_binary_path active/EvEnergyFeature

# --- end fleet deploy ---
