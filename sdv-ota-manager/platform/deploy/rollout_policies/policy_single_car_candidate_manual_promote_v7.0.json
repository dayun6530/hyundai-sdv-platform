{
  "schema_version": 1,
  "policy_id": "policy_single_car_candidate_manual_promote_v7.0",
  "name": "Single car candidate deploy then manual promote for ADAS v7.0",
  "description": "Deploy to candidate (Docker runtime + optional registry pull), wait for operator approval, then promote to primary. Matches the 8-2 car_1 ADAS v7.0 local registry test.",
  "stages": [
    {
      "stage_id": "candidate_deploy",
      "stage_name": "candidate",
      "deploy_action": "candidate",
      "require_ota_ready": true,
      "docker_runtime": {
        "enabled": true,
        "pull_policy": "missing"
      },
      "success_criteria": {
        "docker_runtime_result": "success",
        "expected_log_patterns": [
          "[ADAS v7.0]",
          "Candidate Shadow version is running"
        ]
      }
    },
    {
      "stage_id": "manual_approval",
      "stage_name": "approval",
      "action": "wait_for_manual_approval",
      "required": true
    },
    {
      "stage_id": "primary_promote",
      "stage_name": "promote",
      "deploy_action": "promote",
      "require_candidate_running": true,
      "success_criteria": {
        "docker_runtime_result": "success",
        "primary_log_patterns": [
          "[ADAS v7.0]",
          "Primary production path running"
        ]
      }
    }
  ],
  "health_checks": {
    "forbid_kill_switch": true,
    "require_safe_update_mode": true,
    "max_failure_rate_percent": 0
  },
  "on_failure": "pause_campaign"
}
