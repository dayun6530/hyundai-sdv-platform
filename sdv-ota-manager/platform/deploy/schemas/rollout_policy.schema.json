{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdv-ota-manager/platform/deploy/schemas/rollout_policy.schema.json",
  "title": "Fleet rollout policy",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "policy_id", "name", "stages"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage_id", "stage_name"],
        "properties": {
          "stage_id": { "type": "string" },
          "stage_name": { "type": "string" },
          "deploy_action": { "type": "string", "enum": ["candidate", "promote"] },
          "action": { "type": "string" },
          "required": { "type": "boolean" },
          "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
          "require_ota_ready": { "type": "boolean" },
          "require_candidate_running": { "type": "boolean" },
          "require_manual_approval_before_next_stage": { "type": "boolean" },
          "require_manual_approval_before_promote": { "type": "boolean" },
          "promote_after_success": { "type": "boolean" },
          "rollback_on_failure": { "type": "boolean" },
          "target_selector_override": { "type": "object", "additionalProperties": true },
          "docker_runtime": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "pull_policy": { "type": "string", "enum": ["missing", "always"] }
            },
            "additionalProperties": true
          },
          "success_criteria": {
            "type": "object",
            "properties": {
              "docker_runtime_result": { "type": "string" },
              "expected_log_patterns": { "type": "array", "items": { "type": "string" } },
              "primary_log_patterns": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "health_checks": {
      "type": "object",
      "additionalProperties": true
    },
    "pause_between_stages_sec": { "type": "integer", "minimum": 0 },
    "max_failure_rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "on_failure": { "type": "string", "enum": ["pause_campaign", "rollback", "continue"] }
  }
}
