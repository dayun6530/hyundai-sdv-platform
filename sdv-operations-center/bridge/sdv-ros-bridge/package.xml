<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sdv_ros_bridge</name>
  <version>1.0.0</version>
  <description>ROS 2 bridge: Autoware topics to normalized JSON over WebSocket.</description>
  <maintainer email="sdv@hyundai.com">SDV Platform</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_perception_msgs</depend>
  <depend>sdv_ops_data_core</depend>
  <depend>nlohmann-json-dev</depend>
  <build_depend>libboost-dev</build_depend>
  <exec_depend>libboost-dev</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
